CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="Spiroooo"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="Miro"

CONFIG_BATTERY_USE_REG_BUCK_MAPPING=y

CONFIG_LED_RGB_COLOR=y
CONFIG_SENSOR_ROTATION_0=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_FLASH_LOAD_OFFSET=0x1000

CONFIG_CLOCK_USE_LFXO=y
# XL1 is fed by an active oscillator (gated by P0.30), not a crystal
CONFIG_CLOCK_LFXO_FULL_SWING=y

# nRF52833 UF2 family ID so the Adafruit bootloader accepts drag-and-drop images
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0x621E937A"

# P0.09 (green LED) is an NFC pin; release it as GPIO. Note: the first boot
# after a full chip erase writes UICR and performs one extra reset.
CONFIG_NFCT_PINS_AS_GPIOS=y
